# Railway игнорирует поле Custom Start Command для сервисов из готового образа:
# контейнер стартует как голый `minio`, печатает справку и выходит. Поэтому
# команда запекается в образ.
#
# Форма `sh -c` выбрана намеренно: если Railway всё же подставит свою команду,
# она приедет как аргументы после -c и будет проигнорирована, а не склеится
# с нашими флагами в мусор.
FROM minio/minio:RELEASE.2025-09-07T16-13-09Z

ENTRYPOINT ["/bin/sh", "-c", "exec minio server /data --console-address :9001"]
