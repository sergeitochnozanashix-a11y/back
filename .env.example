# Скопируйте в .env и заполните. .env в git не коммитится.
#
#   cp .env.example .env
#
# JWT_SECRET сгенерировать:  openssl rand -base64 48

# --- PostgreSQL ---
POSTGRES_USER=eduuser
POSTGRES_PASSWORD=

# --- Redis ---
REDIS_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=

# --- JWT ---
# Минимум 32 байта. Утечка секрета = возможность подделать любой токен.
JWT_SECRET=
JWT_EXPIRATION_ACCESS=3600000
JWT_EXPIRATION_REFRESH=86400000

# --- Почта (SMTP) ---
# Для Gmail нужен App Password, а не пароль от аккаунта.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# --- Фронтенд ---
FRONTEND_RESET_PASSWORD_URL=http://localhost:3000/reset-password

# --- ProxyAPI (профиль ai) ---
PROXYAPI_BASE_URL=https://api.proxyapi.ru/openai/v1
PROXYAPI_API_KEY=

# --- Whisper (профиль whisper) ---
# small: ~460 МБ модель, ~1.5 ГБ RAM. medium потребует ~5 ГБ.
WHISPER_MODEL_NAME=small
WHISPER_MAX_DOWNLOAD_MB=50

# --- Инструменты (профили tools / monitoring) ---
PGADMIN_EMAIL=admin@pxel.software
PGADMIN_PASSWORD=admin
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
